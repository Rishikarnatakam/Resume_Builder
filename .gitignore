# Resume Builder - Single Comprehensive .gitignore
# This file handles ALL ignore patterns for the entire project

# ================================
# ENVIRONMENT & CONFIGURATION
# ================================
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.static
.env.backup

# ================================
# PYTHON (Backend)
# ================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
.coverage
.pytest_cache/
.hypothesis/
pytestdebug.log

# ================================
# VIRTUAL ENVIRONMENTS
# ================================
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/
pyvenv.cfg

# ================================
# NODE.JS & FRONTEND
# ================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
.npm
.eslintcache
.stylelintcache
*.tgz
.yarn-integrity
.node_repl_history
/.pnp
.pnp.js
jspm_packages/

# ================================
# BUILD & DISTRIBUTION
# ================================
# Frontend builds
frontend/dist/
frontend/build/
frontend/.vite/
frontend/coverage/
frontend/.next/
frontend/out/

# Python builds
backend/build/
backend/dist/

# ================================
# DATABASES (STRICT!)
# ================================
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
# Removed: backend/latex_resume_ai.db (legacy SQLite - now using Supabase)
backend/data/
data/

# ================================
# STATIC FILES & UPLOADS (VERY STRICT!)
# ================================
# All uploaded files
backend/static/uploaded_pdfs/*
!backend/static/uploaded_pdfs/.gitkeep

# All generated PDFs  
backend/static/generated_pdfs/*
!backend/static/generated_pdfs/.gitkeep

# All PDF files in pdfs directory
backend/static/pdfs/*
!backend/static/pdfs/.gitkeep

# All temporary files
backend/static/temp/*
!backend/static/temp/.gitkeep

# All log files
backend/static/logs/*
!backend/static/logs/.gitkeep

# Any PDFs anywhere (except templates)
*.pdf
!backend/templates/*/preview.png

# ================================
# DOCUMENTS & MEDIA (STRICT!)
# ================================
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx
*.zip
*.rar
*.tar
*.gz
*.7z

# Images (except specific UI assets)
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.ico
*.svg
# Keep only specific UI images
!frontend/public/**/*.png
!frontend/public/**/*.jpg
!frontend/public/**/*.svg
!frontend/src/assets/**/*.png
!frontend/src/assets/**/*.jpg
!frontend/src/assets/**/*.svg
!backend/templates/*/preview.png

# ================================
# LATEX COMPILATION FILES
# ================================
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.bcf
*.run.xml
*.figlist
*.makefile
*.figlist.makefile

