# Backend - Comprehensive .gitignore

# ================================
# PYTHON SPECIFIC
# ================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ================================
# DATABASES (STRICT!)
# ================================
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
# Removed: latex_resume_ai.db (legacy SQLite - now using Supabase)
data/

# ================================
# STATIC FILES (VERY STRICT!)
# ================================
# All uploaded files
static/uploaded_pdfs/*
!static/uploaded_pdfs/.gitkeep

# All generated PDFs
static/generated_pdfs/*
!static/generated_pdfs/.gitkeep

# All PDF files in pdfs directory
static/pdfs/*
!static/pdfs/.gitkeep

# All temporary files
static/temp/*
!static/temp/.gitkeep

# All log files
static/logs/*
!static/logs/.gitkeep

# ================================
# LOGS & DEBUGGING
# ================================
*.log
backend.log
uvicorn.log
fastapi.log

# ================================
# ENVIRONMENT & CONFIG
# ================================
.env
.env.*
config.local.py
settings.local.py

# ================================
# TEST & TEMPORARY FILES
# ================================
test_*.py
*_test.py
cleanup_*.py
reset_*.py
temp_*.py

# ================================
# BACKUP FILES
# ================================
*.bak
*.backup
*.sql.bak

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/

# Environment variables
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python virtual environment
venv/
env/
.venv/

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Database files (legacy SQLite references - now using Supabase PostgreSQL)
*.db-journal
*.db-wal
*.db-shm 