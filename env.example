# API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Security
SECRET_KEY=your-very-secure-secret-key-here-minimum-32-characters

# Model Configuration
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# Database (for production, consider PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./data/latex_resume_ai.db

# Context Caching
DEFAULT_CACHE_TTL_HOURS=24
MIN_CACHE_TOKENS=1024

# File Upload
MAX_PDF_SIZE_MB=10
UPLOAD_DIR=static/uploaded_pdfs

# Security & Auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Production settings
ENVIRONMENT=production
DEBUG=false 