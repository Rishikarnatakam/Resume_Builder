# 🚀 ResumeCraft - Backend Environment Variables
# These are the required secrets for the application to run.
# On Render, set these values in the Environment tab for your service.

# --- Environment ---
ENVIRONMENT=production
DEBUG=false

# --- API Keys ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Model Configuration ---
DEFAULT_GEMINI_MODEL="gemini-2.5-flash"

# --- Supabase / Database ---
# Your full Supabase PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-DB-HOST].supabase.co:5432/postgres

# Your Supabase project details
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your_public_supabase_anon_key
SUPABASE_SERVICE_KEY=your_secret_supabase_service_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_from_project_settings

# --- Payment Processing (Razorpay) ---
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Security ---
SECRET_KEY=your_secret_key_here_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- CORS ---
# The public URL of your deployed Netlify frontend
CORS_ALLOWED_ORIGINS="https://your-app-name.netlify.app"

# --- File Upload Limits ---
MAX_PDF_SIZE_MB=10

# --- Caching ---
DEFAULT_CACHE_TTL_HOURS=24
MIN_CACHE_TOKENS=1024 